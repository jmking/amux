.DS_Store

# build products
macos/.build/
macos/dist/Amux.app/Contents/MacOS/amux
macos/dist/Amux.app/Contents/Resources/amux_amux.bundle
macos/dist/*.dmg
macos/dist/*.zip

# never commit signing material or local secrets
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
.env
.env.*
*.local

# per-release scratch notes, passed to `gh release create --notes-file`
NOTES.md

# agent world: local tooling and raw asset sources (converted USDZ is committed)
tools/
macos/Assets/src/
macos/Assets/work/
# ...except the catalogue with each pack's licence evidence
!macos/Assets/work/
macos/Assets/work/*
!macos/Assets/work/catalog/

# ad-hoc signature written by local dev builds
macos/dist/Amux.app/Contents/_CodeSignature/
macos/dist-test/
